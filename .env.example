# ===== LDL Workspace — cấu hình máy chủ (sao chép thành .env rồi sửa) =====

# Cổng web (mở http://<IP-máy-chủ>:PORT)
PORT=4000

# 0 = hệ thống trống, chỉ tạo tài khoản quản trị bên dưới (dùng thật)
# 1 = tạo dữ liệu mẫu để dùng thử (tài khoản admin / 123456, demo / 123456…)
DEMO_DATA=0

# Tài khoản Chủ doanh nghiệp tạo ở lần chạy đầu (chỉ khi CSDL còn trống và DEMO_DATA=0).
# Để trống ADMIN_PASSWORD: hệ thống sinh mật khẩu ngẫu nhiên và in ra log (docker compose logs).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COMPANY_NAME=Công ty LDL Việt Nam

# Thư mục chứa CSDL + tệp đính kèm khi chạy không dùng Docker (mặc định ./data của gói cài đặt)
# DATA_DIR=/srv/ldl-workspace/data

# Khoá ký phiên đăng nhập (không bắt buộc — để trống thì tự sinh và lưu trong CSDL)
# JWT_SECRET=
