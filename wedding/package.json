{
  "name": "hm-wedding-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "H&M Wedding Invitation Studio — The Art of Forever",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "tsc --noEmit && tsc -p worker --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p worker --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/ballet": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.12",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": ">=22"
  }
}
