{
  // Worker riêng cho website thiệp cưới H&M — tách biệt hoàn toàn với LDL Workspace.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hm-wedding",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/t/*"]
  },
  // Toàn bộ dữ liệu (khách mời, thiết kế, mật khẩu) nằm trong một Durable Object SQLite —
  // không cần tạo D1/KV trước khi deploy.
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "WeddingStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WeddingStore"] }],
  "vars": {
    // Băm PBKDF2 của mật khẩu quản trị ban đầu (không phải mật khẩu thật).
    // Sau khi đăng nhập, đổi mật khẩu trong Studio → Cài đặt; bản băm mới lưu trong Durable Object.
    "ADMIN_PASSWORD_HASH": "pbkdf2$100000$7z9OldoLoX/c6BHPr5RjFQ==$aRP8H+zPoi8luIzmMYRbBHVeFTWVYbX9/FJN1JZTIbs="
  },
  "routes": [{ "pattern": "temp.vanquang.xyz", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
