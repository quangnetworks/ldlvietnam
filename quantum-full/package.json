{
  "name": "quantum-full",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QUANTUM FULL — Lottery Intelligence Platform (phân tích xác suất, kiểm định, tối ưu danh mục vé)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "db:migrate:local": "wrangler d1 migrations apply quantum-full-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply quantum-full-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "setup:local": "node scripts/setup-local.mjs",
    "start:local": "vite --host 127.0.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "hono": "^4.13.19",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  }
}
