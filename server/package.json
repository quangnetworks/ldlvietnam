{
  "name": "ldl-workspace-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/node.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/node.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/node.js",
    "seed": "node --no-warnings=ExperimentalWarning src/node.js --seed",
    "seed:sql": "node src/seed.js --sql",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "cf:dev": "npm --prefix ../client run build && wrangler dev",
    "cf:deploy": "npm --prefix ../client run build && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "wrangler": "^4.137.0"
  }
}